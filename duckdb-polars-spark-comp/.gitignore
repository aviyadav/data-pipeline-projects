# Generated benchmark data. By default the parquet lives in the Docker named
# volume `dpsk-bench_bench-data`, not in the repo; `data/` only appears if you
# run the generator with --out ./data.
data/

# Benchmark output. results/ holds machine-readable JSON, report/timings.svg is
# regenerated by build_report.py; report/REPORT.md is regenerated too but is
# kept in version control on purpose so the numbers are reviewable in a diff.
results/
results-smoke/
report/timings.svg
report-smoke/

# Extracted from the source PDF for reference; the PDF itself is committed.
article.txt

__pycache__/
*.py[cod]
.venv/
.env

# Python tool caches, if you run pytest/ruff/mypy locally rather than in Docker.
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# OS and editor cruft.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Per-developer Compose overrides (e.g. a locally tuned executor memory).
docker-compose.override.yml
